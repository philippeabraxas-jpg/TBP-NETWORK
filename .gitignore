# Secrets et clés — jamais dans le repo, peu importe le sous-dossier
*.pem
*.key
*.p12
*.pfx
*.env
.env.*
!*.example
*secret*
*_rsa
*_ed25519
freeradius/certs/
config/freeradius/certs/

# Python (src/pep, src/telemetry, src/translator probables)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node (si tooling JS pour le lab/CI)
node_modules/

# Build / artefacts
*.log
*.tmp
dist/
build/

# Généré par policies/gen_capabilities.sh — jamais commité (policies/README.md
# et T1, #3 : un fichier figé devient faux dès la prochaine mise à jour d'OPA,
# pire que pas de fichier du tout — régénérer depuis le binaire déployé)
policies/capabilities.json

# Généré par scripts/genesis/genesis_dev.sh (T3) — token SoftHSM de dev,
# clés importées, epoch0.json, ancre simulée, binaire : artefacts locaux,
# régénérés à chaque run, jamais commités
scripts/genesis/out/

# Lab / containerlab
lab/**/*.pcap
lab/**/state/
lab/containerlab/**/.clab/

# OS / éditeurs
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Figures sources volumineuses non versionnées (garder les PNG exportés, pas les binaires lourds d'édition)
figs/src/*.psd
figs/src/*.ai

# Harnais de friction T27 (#29) — artefacts de run : registre tessera local,
# clés de cellule, sels de rapport, mesures. Régénérés à chaque run, jamais
# commités (le sel des feuilles reste chez le producteur, §6.2)
tests/p1_friction/out/

# Campagne red-team T28 (#28) — mêmes artefacts : registre tessera local,
# cell_log.key, evidence_salt.hex (sel local, §6.2), run_report.json,
# leaves_export.json, evidence_log.jsonl. Régénérés à chaque run.
tests/p2_redteam/out/

# Selftest de déploiement T35 (#61) — binaires compilés (pepd), bundles
# OPA, capabilities strippées, keyring DEV, registres tessera locaux
# (cell_log.key), rapport JSON. Régénérés à chaque run, jamais commités.
deploy/selftest/out/
